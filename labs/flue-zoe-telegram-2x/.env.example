# Flue Zoe Telegram channel (2.x port) — LIVE bot config (auto-deployed since 2026-08-09). Copy to .env; never commit a real .env.
#
# Grew out of the 1.x beta's .env.example (labs/flue-zoe-telegram/, removed from
# the repo 2026-09-25) plus the two additions at the bottom; the live .env was
# carried over verbatim at the 2026-08-09 cutover.
#
# NOTE (2.x): the BUILT server (`node dist/server.mjs`) does not read .env — it
# reads only the environment it is started with. The systemd unit supplies it via
# EnvironmentFile=. `vite dev` does load .env files; `flue build`'s implicit
# loading is gone with the command.

# --- Telegram ---
# Bot token. From @BotFather. ONE long-poll consumer per token — stop the other
# one before starting this.
TELEGRAM_BOT_TOKEN=
# NOTE: there is no allow-list env. Identity IS the gate — a sender only reaches
# Zoe's brain if their id resolves to a LINKED Zoe user (account linking below),
# and linking needs a signed token from an authenticated Zoe session. Unlinked
# senders are only ever guided to link. (The old TELEGRAM_ALLOWED_USERS is retired.)

# HTTP port for /health (and the dormant agent route). The watchdog timer reads
# this key out of .env and defaults to 3582; Flue 2.x's own default is 3000, so
# leaving it unset here would break the watchdog and the deploy health check.
#
# DEFAULTS TO THE PARALLEL-TRIAL PORT, NOT 3582. The whole purpose of this lab is
# running BESIDE the live 1.x bot, which holds 3582 — a committed 3582 default
# means the first `cp .env.example .env` produces a config that cannot start
# alongside the thing it is meant to be compared against (cross-review, #1639).
# 33582 matches smoke-built.sh, which already picked a collision-free port for
# exactly this reason. Change this to 3582 ONLY at final cutover, after the 1.x
# unit is stopped — see the README's cutover section.
PORT=33582

# PARALLEL-TRIAL SWITCH. Set to 1 while running BESIDE the live 1.x bot: it makes
# the zoe-data bot-username registration a logged no-op. zoe-data holds exactly ONE
# username and builds every Settings QR / deep link from it, so an unflagged trial
# repoints PRODUCTION deep links at the temporary bot and leaves them there after
# the trial stops. Leave UNSET at cutover — registering the new bot is correct there.
# It also NAMESPACES the zoe-data session ids (trial2x-telegram-<chatId>): the
# same user has the same chatId in both bots, so without it trial prompts and
# replies land in the user's PRODUCTION conversation history.
# ZOE_TELEGRAM_TRIAL=1

# --- Zoe's brain: zoe-data's /api/chat (the SAME pipeline voice + touch use) ---
# This channel does NOT call the local voice Gemma on :11434 — it asks zoe-data,
# which owns intent routing, tools, memory and persona. Default is correct on the
# Jetson; point elsewhere only to test against another zoe-data endpoint.
# ZOE_BRAIN_URL is kept as a back-compat alias for ZOE_DATA_URL.
ZOE_DATA_URL=http://127.0.0.1:8000

# --- Account linking (telegram_id → real Zoe user + their memory) ---
# Shared secret for zoe-data's internal endpoints: the telegram→user resolver
# (/api/system/resolve-telegram/<id>) and the trusted /api/chat user override
# (X-Zoe-User-Id). Must match zoe-data's ZOE_INTERNAL_TOKEN. On loopback zoe-data
# also accepts calls with NO token, so this may be left empty when the bot runs on
# the same box as zoe-data; set it if the bot ever runs off-box.
ZOE_INTERNAL_TOKEN=

# HOW LINKING WORKS: each user stores their numeric Telegram id in their Zoe
# profile (PUT /api/user/profile/telegram, session-authed as themselves). On each
# message the bot resolves the verified sender's id to that Zoe user and forwards
# the turn as them. Unlinked senders are told their numeric id and asked to set it
# in Zoe settings — they never reach the brain as a real user.

# ─────────────────────────────────────────────────────────────────────────────
# NEW IN THE 2.x PORT — both optional, both default to the 1.x behaviour.
# ─────────────────────────────────────────────────────────────────────────────

# Flue's own conversation store. The 2.x runtime stores schema v8 and REFUSES to
# open the beta's v5 database (and the beta refuses a v8 one), so a trial or a
# cutover must point at a FRESH path — never the live bot's data/zoe.db.
# Default: <package>/data/zoe.db
# ZOE_TELEGRAM_DB=

# Telegram Bot API root. Test/offline hook only — the offline suite points the
# whole transport at a mock Bot API so it never reaches api.telegram.org.
# NEVER set this on the deployed unit.
# TELEGRAM_API_ROOT=https://api.telegram.org

# The `/new` session-epoch map (our own JSON, not a Flue store — it DOES carry
# across the 1.x→2.x boundary; copy it at cutover to preserve /new history).
# Default: <package>/data/session_epochs.json
# SESSION_EPOCHS_PATH=

# ─────────────────────────────────────────────────────────────────────────────
# VOICE NOTES IN AND OUT (flag-dark, owner decision Q17 2026-10-04: reply in kind).
# All default OFF / today's behaviour. zoe-data must ALSO have ZOE_TELEGRAM_MEDIA=1
# (its telegram_media router does the decode/STT/TTS/encode); with it off, a voice
# note gets a polite "couldn't take that in" reply. docs/knowledge/telegram-voice-notes.md
# ─────────────────────────────────────────────────────────────────────────────
# Register the message:voice + message:audio handlers. Unset = voice notes are
# received by the poll loop and ignored, exactly as before.
# ZOE_TELEGRAM_VOICE_NOTES=1
# How to answer a voice note: voice (default — in kind) | text | both.
# ZOE_TELEGRAM_VOICE_REPLY=voice
# Longest note accepted, seconds (checked BEFORE download; zoe-data reads the same name).
# ZOE_TELEGRAM_VOICE_MAX_S=60
# Forwarded voice notes are someone else's words and are REFUSED by default
# (the telegram channel profile allows writes). 1 = accept them, framed as a quote.
# ZOE_TELEGRAM_ALLOW_FORWARDED=0
# Public base URL of Zoe (the Cloudflare tunnel host). When set, `/talk` answers
# with a "Talk to Zoe" button to the existing push-to-talk page <base>/voice.html.
# Unset = no /talk command (it falls through to the brain as text, as today).
# ZOE_BASE_URL=
