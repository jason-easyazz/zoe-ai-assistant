# zoe-night-window.timer - READY TO INSTALL (the operator runs scripts/night/install_night_window.sh). 02:50 local, after the 02:00 training / 02:30 backup / 02:40 memory-export timers, so the export keeps its
# "copy BEFORE the digest mutates the store" guarantee, and early enough that the window (hard cap 65 min, ExecStart --end-by 03:55) is over by 03:55: zoe-data must be back
# before its Sunday 04:00 consolidation loop and the 04:10-04:52 voice gate (Serena restart 04:15, nightly voice gate 04:30).
#
# Persistent=false ON PURPOSE: a missed run (box off at 02:50) must NOT fire at the next boot in the middle of the day and put Zoe to sleep. The script also
# refuses to START outside 01:30-03:40 unless a human passes --anytime.
[Unit]
Description=Zoe night window timer (02:50)

# RETRIES (2026-10-27): the 02:50 start can be refused (2026-10-26: a voice lander held the box, the night was lost) and the only other attempt was a hand-run at 03:40 that the
# 03:55 end-by refused ("only 15 min remain"). 03:05 and 03:15 are the same service again; the service passes --skip-if-done, so a retry exits 0 at once on a night whose window already
# RAN (any outcome) and runs a full window only on positive evidence that the earlier attempt was REFUSED (stopped nothing). 03:15 (+<=2 min jitter) is the LAST slot the preflight accepts: a window needs 35 min before 03:55 (a test pins it).
# If the 02:50 run is still waiting on a lander (it waits up to 20 min) the timer's activation finds the unit running and does nothing.
[Timer]
OnCalendar=*-*-* 02:50:00
OnCalendar=*-*-* 03:05:00
OnCalendar=*-*-* 03:15:00
RandomizedDelaySec=120
AccuracySec=1min
Persistent=false
Unit=zoe-night-window.service

[Install]
WantedBy=timers.target
