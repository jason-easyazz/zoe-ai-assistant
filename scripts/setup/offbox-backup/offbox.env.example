# Copy to ~/.config/zoe-backup/offbox.env (chmod 600). Read by scripts/maintenance/zoe_offbox.py.
# Runbook: docs/knowledge/offbox-backup.md. Never commit the filled-in copy.
#
# The repo URL carries NO credentials (a URL with user:pass shows up in process listings; the script refuses it).
RESTIC_REPOSITORY=rest:https://backup.the411.life/<hid>/
# rest-server htpasswd user for this household = the household id <hid> (the relay enrolment id once R1 exists).
RESTIC_REST_USERNAME=<hid>
RESTIC_REST_PASSWORD=<the household's rest-server password>
# This box's OWN restic key (restic key add), not the owner's master password. chmod 600.
RESTIC_PASSWORD_FILE=~/.config/zoe-backup/restic.pass
# age PUBLIC recipient(s) only (age1...). The identity (AGE-SECRET-KEY-...) lives in the owner's vault, never here:
# the script refuses to run if it finds one in this directory.
ZOE_BACKUP_AGE_RECIPIENTS_FILE=~/.config/zoe-backup/age-recipients.txt
# Upload cap in KiB/s (0 = unlimited). 2048 ~ 16 Mbit/s.
ZOE_BACKUP_LIMIT_UPLOAD_KIB=2048
# Optional: RESTIC_BIN / AGE_BIN when not on PATH or in ~/.local/bin; RESTIC_CACERT for a private CA.
