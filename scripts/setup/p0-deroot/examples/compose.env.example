# P0-1 EXAMPLE, NOT installed by anything (docs/architecture/p0-deroot.md sections 4.4 and 5): the NAMES the
# root-owned /etc/zoe/compose.env must define for zoe-compose-deploy, which renders docker-compose.yml and
# docker-compose.modules.yml from its own export of main (an exported tree has no .env). Values are the owner's:
# copied from the checkout's .env, never committed. Owner install (as zoe-admin):
#   sudo install -d -m 0755 -o root -g root /etc/zoe
#   sudo install -m 0600 -o root -g root <filled copy> /etc/zoe/compose.env
# The helper refuses (exit 6, "not ready") unless the file is a root-owned 0600 regular file.
POSTGRES_PASSWORD=
HA_ACCESS_TOKEN=
HA_BASE_URL=
HA_OIDC_CLIENT_ID=
HA_OIDC_CLIENT_SECRET=
KEEPER_AUTH_TOKEN=
KEEPER_BASE_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
MULTICA_DEV_CODE=
MULTICA_JWT_SECRET=
MULTICA_OIDC_CLIENT_ID=
MULTICA_OIDC_CLIENT_SECRET=
MULTICA_WEBHOOK_SECRET=
OMNIGENT_OIDC_CLIENT_ID=
OMNIGENT_OIDC_CLIENT_SECRET=
RESEND_API_KEY=
ZOE_BASE_URL=
ZOE_BOARD_WEBHOOK_URL=
ZOE_HA_VOICE_INGRESS_URL=
ZOE_HA_VOICE_TOKEN=
HERMES_MULTICA_AGENT_ID=
# P0-2 bind sources (data moved under /srv/zoe, root or the container's uid): today only Music Assistant's is a
# variable; zoe-auth's data and zoe-ui's dist and ssl are literal paths in docker-compose.yml, so P0-2 must make them
# variables too before zoe-compose-deploy stops answering "not ready" for those services.
ZOE_MA_DATA=/srv/zoe/music-assistant
