# P0-1 EXAMPLE, NOT installed by anything (docs/architecture/p0-deroot.md section 5). The one line the owner adds to
# the self-hosted runner's env file (~/actions-runner/.env) so deploy jobs reach Docker only through the allowlisted
# proxy. Same switch as environment.d/60-zoe-docker-proxy.conf; the docker CLI reads it, and with it absent it uses
# /var/run/docker.sock exactly as today. Takes effect on the runner's next restart, and ONLY after a reboot has given
# the runner's user manager the zoe-dockerproxy group (group changes never reach running processes).
DOCKER_HOST=unix:///run/zoe-docker-proxy/docker.sock
