# Weekly on-box restore check + the MONTHLY off-box restore drill (architecture deep dive A5): restores the newest
# snapshot of every tier from the411 to a scratch dir, compares sha256 with what was sent, reads 1/12 of the repo's
# data, and alerts when the household tier is older than 35 days (the411's prune stopped) or backups stop landing.
# Tracked 2026-10-18; was ~/scripts/maintenance/zoe-backup-verify.sh.
[Unit]
Description=Weekly Zoe backup restore-verify (+ monthly off-box restore drill)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/assistant/scripts/maintenance/zoe-backup-verify.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=3h
StandardOutput=append:%h/.zoe-logs/backup-verify.log
StandardError=append:%h/.zoe-logs/backup-verify.log
