# Size-based rotation for the logs systemd appends to (zoe-data's stdout/stderr
# capture, the crash-loop watcher, the memory export, the voice regression).
#
# WHY: `StandardOutput=append:` never rotates, logrotate is not installed on the
# host, and a user manager cannot run a system logrotate timer. The host's older
# untracked ~/bin/zoe-logs-rotate.sh (daily 02:50) only acts above 150 MB and
# keeps a 50 MB tail via a non-atomic rewrite, so on 2026-10-04 zoe-data.stderr.log
# stood at 119 MB and zoe-data.stdout.log at 86 MB.
# Full rationale + the copytruncate semantics: scripts/maintenance/rotate_service_logs.py
# and docs/knowledge/log-review-2026-10-04.md.
#
# OPERATOR STEP (a user unit; nothing here is installed by a deploy).
# RETIRE THE OLD PAIR FIRST so two rotators never share the files
# (incident-runbook.md section 26, step 1):
#   systemctl --user disable --now zoe-logs-rotate.timer
#   cp scripts/setup/systemd/zoe-log-rotate.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now zoe-log-rotate.timer
#   systemctl --user start zoe-log-rotate.service   # one rotation now (>= 50 MB files)
# Dry run first (changes nothing):
#   python3 scripts/maintenance/rotate_service_logs.py --dry-run

[Unit]
Description=Rotate size-bloated zoe log files in ~/.zoe-logs

[Service]
Type=oneshot
# The text-log retention pass reads ZOE_TEXT_LOG_RETENTION_DAYS / ZOE_ROUTER_HEAD_LOG from the zoe-data env files (the same ones,
# same order, as zoe-data.service) so an owner's `keep` is honoured. The script also parses these files itself, so a unit that was
# not re-installed is still correct; re-install it to make the unit match the repo.
EnvironmentFile=-%h/assistant/.env
EnvironmentFile=-%h/assistant/services/zoe-data/.env
ExecStart=/usr/bin/python3 %h/assistant/scripts/maintenance/rotate_service_logs.py
Nice=10
IOSchedulingClass=idle
# Its own output is a line per rotation; journald is volatile on this host, so
# keep it with the rest instead of losing it.
StandardOutput=append:%h/.zoe-logs/log-rotate.log
StandardError=append:%h/.zoe-logs/log-rotate.log
