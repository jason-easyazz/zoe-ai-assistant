# Sunday 05:30 (deep dive 2 S0-8): after the night window (01:35-04:55; the 12B runs 02:50 to ~03:10) and the 02:30
# on-box backup, before the household's day. The on-box restore drill also refuses inside the window or while
# zoe-night-window runs, waits for a running zoe-backup / zoe-offbox-backup (05:10), and refuses below its
# MemAvailable floor (2000 MB) with an alert.
[Unit]
Description=Weekly restore drill of Zoe backups (Sunday 05:30 local)

[Timer]
OnCalendar=Sun *-*-* 05:30:00
RandomizedDelaySec=300
Persistent=true
Unit=zoe-backup-verify.service

[Install]
WantedBy=timers.target
