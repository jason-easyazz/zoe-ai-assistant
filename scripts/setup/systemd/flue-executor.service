# Flue Executor (lab) — the supervised process that consumes Multica's REAL
# agent_task_queue and runs phase workers one at a time (Phase 2 of the Multica
# executor migration, docs/architecture/multica-executor-migration.md).
#
# OPTIONAL and NOT enabled by default. Installing/enabling this unit is an
# explicit operator action. Nothing here is auto-installed.
#
# The installer installs this INERT, opt-in unit and arms NO dispatch gate — it
# never enables the unit and never touches the shared Multica pause sentinel
# ~/.zoe/multica_dispatch_paused (that file is read every cycle by the already-live
# board, so recreating it on a reinstall would halt live dispatch). Safety after
# install rests on two gates that ship ON by construction:
#   * NOT AUTO-ENABLED — installed as a template, never added to the auto-enabled
#     systemd spine; enabling this unit is a deliberate operator act.
#   * DRY DISPATCH (default) — ZOE_EXECUTOR_DISPATCH defaults to `dry` (poll + log
#     what it WOULD claim, mutate nothing). Set it to `full` in the env file only
#     when the loop is being taken live.
#   * SINGLE LANE — the claim logic dispatches at most one task at a time per
#     runtime, so a board of issues never fans out into concurrent Omnigent
#     sessions (the "don't eat usage" guard).
# OPTIONAL pause: arming ~/.zoe/multica_dispatch_paused makes the runner idle and
# claim nothing, but that is an operator tool (it pauses the whole shared board),
# not something install performs — see scripts/setup/systemd/README.md.
#
# Prereqs (the unit runs, it does not build):
#   cd ~/assistant/labs/flue-executor && npm install
#   # register the executor identity in Multica (idempotent):
#   python3 ~/assistant/scripts/maintenance/verify_executor_queue_backend.py
#   # create the env file from the template if not already present, and adjust
#   # (-n keeps a .env you pre-created with a custom ZOE_MULTICA_KILL_SWITCH or
#   # dispatch setting so it is not silently reset to the template default):
#   cp -n ~/assistant/labs/flue-executor/.env.example ~/assistant/labs/flue-executor/.env
[Unit]
Description=Flue Executor (lab) — single-lane Multica queue consumer
# Reads Multica's DB (via the shared zoe-database container). Restart=always
# recovers start-order races on boot (same pattern as flue-zoe-brain.service).
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/assistant/labs/flue-executor
# Adjust the node path if you are not using nvm (same convention as flue-zoe-brain).
ExecStart=%h/.nvm/current/bin/node --experimental-strip-types src/live-runner.ts
Restart=always
RestartSec=5
# ZOE_EXECUTOR_MODE=live is REQUIRED (the runner refuses to start otherwise).
# ZOE_EXECUTOR_DISPATCH (dry|full), MULTICA_DATABASE_URL/POSTGRES_URL, and any
# Omnigent overrides live in the lab-local .env — copy .env.example and fill it
# in. NEVER inline secrets here. The file is required (no '-' prefix): the unit
# fails loudly if the operator has not configured it.
Environment=ZOE_EXECUTOR_MODE=live
# Pin the live service env file to THIS account's checkout (%h) so ZOE_ENV_FILE
# is explicit in the unit: config.ts derives POSTGRES_URL from ZOE_ENV_FILE and,
# when it is unset, falls back to a homedir()-derived
# ~/assistant/services/zoe-data/.env — so a non-`zoe` operator already resolves
# to their own home. Setting it here just makes that resolution explicit. An
# explicit ZOE_ENV_FILE in the .env below still wins (EnvironmentFile is applied
# after Environment).
Environment=ZOE_ENV_FILE=%h/assistant/services/zoe-data/.env
EnvironmentFile=%h/assistant/labs/flue-executor/.env

# Light hardening (user-service compatible).
NoNewPrivileges=true
RestrictRealtime=true

[Install]
WantedBy=default.target
