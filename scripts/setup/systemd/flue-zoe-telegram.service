# Flue Zoe Telegram channel (lab) — long-poll bot bridged to zoe-data's /api/chat,
# with per-sender account linking (telegram_id → real Zoe user + their memory).
#
# OPTIONAL and NOT enabled by default. Installing/enabling this unit is an
# explicit operator action (runbook: labs/flue-zoe-telegram-2x/README.md). The bot
# token is a secret the operator holds; nothing here is auto-installed.
#
# Build first (the unit runs the built output, it does not build):
#   cd ~/assistant/labs/flue-zoe-telegram-2x && npm install && npm run build
# Then create the env file from the template and fill it in:
#   cp ~/assistant/labs/flue-zoe-telegram-2x/.env.example ~/assistant/labs/flue-zoe-telegram-2x/.env
#   IMPORTANT: .env.example ships PORT=33582 (the parallel-TRIAL port, chosen to
#   run beside a live bot). For THIS unit set PORT=3582 — the watchdog and the
#   deploy health check both probe :3582 literally:
#   sed -i 's/^PORT=33582/PORT=3582/' ~/assistant/labs/flue-zoe-telegram-2x/.env
[Unit]
Description=Flue Zoe Telegram channel (lab)
# Talks to zoe-data (:8000) for the resolver + /api/chat. A user unit cannot
# order itself after that reliably on boot; Restart=always recovers start-order
# races (same pattern as zoe-data.service / flue-zoe-brain-2x.service).
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/assistant/labs/flue-zoe-telegram-2x
# Adjust the node path if you are not using nvm (same convention as flue-zoe-brain-2x).
ExecStart=%h/.nvm/current/bin/node dist/server.mjs
Restart=always
RestartSec=5
# Secrets and identity (TELEGRAM_BOT_TOKEN, ZOE_DATA_URL,
# ZOE_INTERNAL_TOKEN, ...) live in the lab-local .env — copy .env.example and fill
# it in. NEVER inline values here. The file is required (no '-' prefix): the unit
# fails loudly if the operator hasn't configured it, and the bot itself throws on
# a missing TELEGRAM_BOT_TOKEN anyway.
EnvironmentFile=%h/assistant/labs/flue-zoe-telegram-2x/.env

# ── Keep the channel bridge out of swap ──────────────────────────────────────
# Same gap as flue-zoe-brain-2x.service, and worse: measured on the live Orin
# 2026-08-03 this unit had NO memory directives at all, so its cgroup
# `memory.low` was 0 — zero reclaim protection, the exact state kokoro-tts was
# in before #1409. It held VmRSS 6.1 MB against VmSwap 65.2 MB (78% paged out),
# with MemoryMax and MemorySwapMax both `infinity`.
#
# Consequence is a product bug, not just a number: the first Telegram reply
# after an idle period faults the bridge back from disk before it can even
# reach zoe-data. This unit is also what `zoe_crash_loop_watch.py` sends its
# alerts through, so it must not be cold exactly when the box is in trouble.
#
# Pure userspace Node (0 CUDA/NvMap mappings verified in /proc/<pid>/maps), so
# cgroup accounting is complete and MemoryMax genuinely bounds it.
#
# Sizing. Corrected alongside flue-zoe-brain — the original 768M was a multiple
# of VmHWM (145.9 MB), and VmHWM was sampled on an already-starved box, so it is
# a LOWER bound on the unstressed peak. See flue-zoe-brain-2x.service for the full
# measurement; the load-bearing part applies here identically: V8 sizes its JS
# heap to ~51% of the cgroup ceiling, so a JS-heap runaway hits V8's limit first
# (a logged, attributable heap-OOM — which still usually terminates the process,
# it is just not an opaque SIGKILL). EXTERNAL memory (Buffers, stream chunks) is
# outside that budget and CAN reach the ceiling unmediated (verified: exit 137
# under MemoryMax=1G + MemorySwapMax=0).
#
#   MemoryLow=256M  — carried over unchanged from 5c06fe8a, which introduced
#                     this unit's first-ever memory directives; before that the
#                     unit had none at all and its cgroup memory.low was 0.
#                     A lower floor than the brain's 512M on purpose: a cold
#                     Telegram reply is a slow message, not a voice fault.
#   MemoryMax=1G    — ~7x the (understated) measured peak, and half the brain's
#                     backstop. Deliberately tighter than the brain because this
#                     bridge long-polls small JSON rather than streaming model
#                     output, so it has far less external-buffer exposure, and
#                     Restart=always makes a kill genuinely cheap here.
#
# It keeps a ceiling for the same reason the brain does: uncapped, V8 would size
# its heap to 4144 MB on this 15.6 GB box. A bounded bridge is the safe default.
#
# Apply runbook: docs/knowledge/memory-pressure-profile.md.
# No Nice=-N / OOMScoreAdjust=-N — silently dropped on a --user unit.
MemorySwapMax=0
MemoryLow=256M
MemoryMax=1G

# Light hardening (user-service compatible).
NoNewPrivileges=true
RestrictRealtime=true

[Install]
WantedBy=default.target
