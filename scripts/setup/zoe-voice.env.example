# Zoe panel voice daemon - the configuration as code (deep dive 2 V-3, 2026-10-19).
#
# EVERY key the panel daemon and its companions read (zoe_voice_daemon.py, zoe_voice_announce.py,
# zoe_voice_enroll_mode.py, zoe_speaker_resnet34.py, zoe_enroll_flow.py, zoe_face_id.py) is listed here,
# with its code default and one line of meaning. tests/unit/test_panel_env_template.py fails when the code
# reads a key this file does not list, or this file lists a key nothing reads.
#
#   KEY=value     an ACTIVE line: the live panel sets it, to the TUNED value (zoe-touch-pi, 2026-10-19)
#   #KEY=value    not set on the panel: the code default applies (shown)
#   # KEY [tag]: one-line meaning. Tags: [secret] never printed or committed (placeholder here);
#                [site] per-device (URL, id, path, device) - its value may legitimately differ per panel;
#                [legacy] a deprecated alias the daemon still accepts.
#
# Where it lives: the Pi's ~/.zoe-voice/.env.voice (EnvironmentFile of the zoe-voice USER unit; mode 600 -
# it holds the device token). install-voice-service.sh copies this file to /etc/zoe-voice.env on a Jetson.
# Drift between the live panel and this file: python3 scripts/maintenance/panel_env_drift.py (read-only,
# over ssh; key names only, never a secret value). Change one, change the other.

# ── Identity and connection ─────────────────────────────────────────────────────────────────────────────
# ZOE_URL [site]: zoe-data base URL the panel talks to (nginx on the Jetson). Default https://zoe.local.
ZOE_URL=https://zoe.local
# PANEL_ID [site]: this panel's id (panel list, push channel panel_<id>, announcements). Default zoe-touch-pi.
PANEL_ID=zoe-touch-pi
# DEVICE_TOKEN [secret]: the panel's device token (minted by an admin; X-Device-Token on every API call). Required.
DEVICE_TOKEN=__SECRET__
# VERIFY_SSL: verify zoe-data's TLS certificate. Default true; the panel runs false (self-signed Jetson cert).
VERIFY_SSL=false
# CF_ACCESS_CLIENT_ID [secret]: Cloudflare Access service-token id - ONLY a virtual panel through the tunnel. Default unset.
#CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET [secret]: the Access token's secret half (both or neither; refused for a LAN ZOE_URL). Default unset.
#CF_ACCESS_CLIENT_SECRET=
# HA_BRIDGE_URL [site]: Home Assistant bridge base URL for the legacy bridge route. Default unset (bridge off).
HA_BRIDGE_URL=http://zoe.local:8007
# VOICE_ROUTE_MODE: direct = every turn to zoe-data; the bridge mode is legacy. Default direct.
VOICE_ROUTE_MODE=direct
# VOICE_API_MAX_RETRIES: retries for a transient zoe-data error (408/429/5xx, transport). Default 2.
VOICE_API_MAX_RETRIES=1
# VOICE_API_RETRY_BACKOFF_S: first retry backoff, doubled per attempt. Default 0.35.
VOICE_API_RETRY_BACKOFF_S=0.20
# PANEL_PLATFORM [site]: pi | mac | auto - the OS backend (player, duck, panel agent). Default pi.
#PANEL_PLATFORM=pi

# ── Audio devices ───────────────────────────────────────────────────────────────────────────────────────
# AUDIO_DEVICE [site]: microphone (PyAudio name or index; "pulse" on the panel). Default default.
AUDIO_DEVICE=pulse
# MIC_DEVICE_INDEX [legacy]: old name for AUDIO_DEVICE (read only when AUDIO_DEVICE is unset).
#MIC_DEVICE_INDEX=
# AUDIO_OUTPUT_DEVICE [site]: playback device for replies and beeps. Default = AUDIO_DEVICE.
AUDIO_OUTPUT_DEVICE=pulse
# SAMPLE_RATE: mic sample rate in Hz (the wake model, Silero and STT all expect 16000). Default 16000.
SAMPLE_RATE=16000
# CHUNK_SIZE: samples per mic read (1280 = 80 ms, openWakeWord's frame). Default 1280.
CHUNK_SIZE=1280

# ── Wake word ───────────────────────────────────────────────────────────────────────────────────────────
# The model is ~/.zoe-voice/hey_zoe.onnx (custom, not in git; sha256 pinned in models.lock, a copy in
# ~/.zoe/backups/panel/ on the Jetson). Without it the daemon falls back to the bundled "hey jarvis".
# WAKEWORD_THRESHOLD: openWakeWord score that counts as a wake hit. Default 0.28; the panel is tuned to 0.45.
WAKEWORD_THRESHOLD=0.45
# OWW_THRESHOLD [legacy]: old name for WAKEWORD_THRESHOLD.
#OWW_THRESHOLD=
# WAKE_CONFIRM_COUNT: hits >= threshold needed within WAKE_CONFIRM_WINDOW_S to fire. Default 2.
WAKE_CONFIRM_COUNT=3
# WAKE_CONFIRM_WINDOW_S: the confirmation window in seconds. Default 0.8.
WAKE_CONFIRM_WINDOW_S=1.0
# MIN_WAKE_INTERVAL_S: minimum seconds between two wakes. Default 3.0.
MIN_WAKE_INTERVAL_S=5.0
# WAKEWORD_DEBUG: 1 logs the max wake score every 5 s (mic/model sensitivity check). Default off.
WAKEWORD_DEBUG=0
# WAKE_BEEP_ENABLED: play the local beep the moment the wake fires. Default true.
WAKE_BEEP_ENABLED=true
# WAKE_BEEP_FREQ_HZ: beep pitch in Hz. Default 1046 (C6).
#WAKE_BEEP_FREQ_HZ=1046
# WAKE_BEEP_DURATION_MS: beep length in ms. Default 120.
WAKE_BEEP_DURATION_MS=130
# WAKE_BEEP_VOLUME: beep volume 0..1. Default 0.22.
WAKE_BEEP_VOLUME=0.35
# PREROLL_CHUNKS: 80 ms chunks kept before the wake fires and prepended to the command (1.6 s). Default 20.
#PREROLL_CHUNKS=20
# POST_PLAY_COOLDOWN_S: ignore wake scores this long after a voice cycle or announcement (echo guard). Default 0.4.
POST_PLAY_COOLDOWN_S=0.4
# POST_PLAY_TAIL_S: extra settle time after playback before the wake re-arms (room reverb). Default 0.4.
POST_PLAY_TAIL_S=0.25

# ── Recording and endpointing ───────────────────────────────────────────────────────────────────────────
# RECORD_SECONDS_MAX: SOFT cap (s); past it a recording stays open only while the speaker is still talking. Default 12.
RECORD_SECONDS_MAX=12
# RECORD_SECONDS_HARD_MAX: HARD cap (s) for a still-talking speaker. Default 30.
#RECORD_SECONDS_HARD_MAX=30
# CONV_RECORD_SECONDS_HARD_MAX: hard cap (s) in conversation mode. Default 60.
#CONV_RECORD_SECONDS_HARD_MAX=60
# RECORD_SNAP_S: at the hard cap, run on up to this long to the next pause so the cut lands between words. Default 3.0.
#RECORD_SNAP_S=3.0
# RECORD_STILL_SPEAKING_RATIO: share of the last 2 s that must be speech to stay open past the soft cap. Default 0.5.
#RECORD_STILL_SPEAKING_RATIO=0.5
# ZOE_CONTINUE_WINDOW_S: listen this long for the rest of a capped or "...and"-ending clip, then send one merged clip. Default 2.0.
#ZOE_CONTINUE_WINDOW_S=2.0
# SILENCE_TIMEOUT_S: amplitude-mode tail, and the pre-speech timeout in VAD mode (s). Default 1.5.
SILENCE_TIMEOUT_S=1.5
# RECORD_SILENCE_AMPLITUDE: mean |sample| below which a chunk is quiet (amplitude mode). Default 300.
RECORD_SILENCE_AMPLITUDE=300
# VAD_ENDPOINT_ENABLED: end turns on Silero speech-absence instead of amplitude. Default false; the panel runs it on.
VAD_ENDPOINT_ENABLED=1
# VAD_ENDPOINT_SILENCE_S: VAD-mode any-quiet tail after speech (s). Default 0.8.
VAD_ENDPOINT_SILENCE_S=0.8
# VAD_ENDPOINT_THRESHOLD: Silero probability that counts as speech for endpointing. Default 0.35.
#VAD_ENDPOINT_THRESHOLD=0.35
# ZOE_VAD_TAIL_MS: deep-quiet fast tail (ms of consecutive deep quiet that closes the turn); 0 = off. Default 0.
ZOE_VAD_TAIL_MS=640
# ZOE_VAD_TAIL_DEEP_PROB: Silero probability below which quiet counts as DEEP (clamped below the speech threshold). Default 0.10.
#ZOE_VAD_TAIL_DEEP_PROB=0.10
# ZOE_VAD_CLEAN_TAIL_MS: adaptive tail - a clean fall closes after this many ms (floor 500); 0 = off. Default 0.
#ZOE_VAD_CLEAN_TAIL_MS=0
# ZOE_VAD_CLEAN_FALL_CHUNKS: ambiguous decay chunks still allowed in a "clean" fall. Default 2.
#ZOE_VAD_CLEAN_FALL_CHUNKS=2
# ZOE_VAD_CLEAN_MIN_SPEECH_MS: speech needed before the clean tail may apply. Default 480.
#ZOE_VAD_CLEAN_MIN_SPEECH_MS=480
# ZOE_VAD_HESITATION_TAIL_MS: any-quiet limit after a hesitation (capped at 1500); 0 = off. Default 0.
#ZOE_VAD_HESITATION_TAIL_MS=0
# ZOE_SPECULATIVE_TURN: B1.1 speculative turn-start (fire at the first end-of-turn verdict). Default off.
#ZOE_SPECULATIVE_TURN=false
# ZOE_SPECULATIVE_TAIL_MS: deep quiet before the speculative first verdict (ms). Default 320.
#ZOE_SPECULATIVE_TAIL_MS=320
# ZOE_STT_STREAM_UPLOAD: upload the mic audio to the server's under-speech STT while the user speaks. Default off.
ZOE_STT_STREAM_UPLOAD=1
# VOICE_IGNORE_TRANSCRIPTS: comma list of transcripts never sent to chat (fillers, STT noise). Default yes,yeah,...,hmm,um.
VOICE_IGNORE_TRANSCRIPTS=yes,yeah,yep,yup,no,ok,okay,thank_you,thanks,hi,hello,hmm,um,uh,you,allright,alright,so,well,right,oh,ah,mm,mmhmm,mhm,nope,sure,cool,we,i,the,a,and,or,but,what,huh,eh,ha,haha,hehe,hm

# ── Follow-up and conversation ──────────────────────────────────────────────────────────────────────────
# FOLLOW_UP_LISTEN_S: after a reply, listen this long for speech without the wake word. Default 5.0.
FOLLOW_UP_LISTEN_S=5.0
# FOLLOW_UP_MAX_TURNS: follow-up turns after the first reply before wake is needed again. Default 5.
FOLLOW_UP_MAX_TURNS=999
# FOLLOW_UP_VAD_THRESHOLD: Silero probability that opens a follow-up recording. Default 0.35.
FOLLOW_UP_VAD_THRESHOLD=0.50
# FOLLOWUP_LOOKBACK_CHUNKS: chunks kept before the follow-up trigger (the first syllable). Default 4.
#FOLLOWUP_LOOKBACK_CHUNKS=4
# CONV_WINDOW_S: conversation mode ("let's talk") listen window per turn (s). Default 12.0.
#CONV_WINDOW_S=12.0
# CONV_MAX_TURNS: conversation mode turn cap. Default 40.
#CONV_MAX_TURNS=40
# CONV_MAX_S: conversation mode duration cap (s). Default 300.
#CONV_MAX_S=300
# CONV_SILENT_WINDOWS: silent windows in a row that close a conversation. Default 2.
#CONV_SILENT_WINDOWS=2
# CONV_BEEP: first | every | off - when conversation mode beeps. Default first.
#CONV_BEEP=first

# ── Streaming replies and playback ──────────────────────────────────────────────────────────────────────
# ZOE_VOICE_STREAM: use the streamed turn (/api/voice/turn_stream) instead of the blocking one. Default 1.
ZOE_VOICE_STREAM=1
# ZOE_BUFFER_PHRASES: play a "thinking" phrase when the answer is slow. Default 1.
#ZOE_BUFFER_PHRASES=1
# ZOE_BUFFER_DELAY_S: only after this many seconds without an answer. Default 0.8.
#ZOE_BUFFER_DELAY_S=0.8
# ZOE_TTS_TRIM_SILENCE: trim each TTS chunk's leading/trailing near-silence. Default true.
#ZOE_TTS_TRIM_SILENCE=true
# ZOE_TTS_KEEP_TAIL_MS: silence kept at the end of a trimmed chunk (ms). Default 130.
#ZOE_TTS_KEEP_TAIL_MS=130
# ZOE_TTS_LEAD_GUARD_MS: silence kept at the start of a trimmed chunk (ms). Default 20.
#ZOE_TTS_LEAD_GUARD_MS=20

# ── Barge-in ────────────────────────────────────────────────────────────────────────────────────────────
# BARGE_IN_ENABLED: stop (or duck) the reply when the user talks over it. Default true.
BARGE_IN_ENABLED=true
# BARGE_IN_THRESHOLD: Silero probability that counts as barge-in speech, in (0, 1]. Default 0.5.
BARGE_IN_THRESHOLD=0.75
# BARGE_MIN_CHUNKS: speech chunks needed within BARGE_WINDOW_CHUNKS. Default 3.
#BARGE_MIN_CHUNKS=3
# BARGE_WINDOW_CHUNKS: the rolling window in chunks. Default 6.
#BARGE_WINDOW_CHUNKS=6
# BARGE_GRACE_MS: ignore this long after playback starts (Zoe's own onset in the mic). Default 800.
#BARGE_GRACE_MS=800
# BARGE_FAST_PROB: fast path - consecutive chunks at or above this probability. Default 0.95.
#BARGE_FAST_PROB=0.95
# BARGE_FAST_CHUNKS: fast path chunk count; 0 = off. Default 2.
#BARGE_FAST_CHUNKS=2
# BARGE_DUCK_ENABLED: duck -> decide -> resume instead of a hard stop. Default false.
#BARGE_DUCK_ENABLED=false
# BARGE_DUCK_DB: duck gain in dB, in [-60, 0). Default -15.0.
#BARGE_DUCK_DB=-15.0
# BARGE_DUCK_RAMP_MS: duck ramp; 0 = one step. Default 0.
#BARGE_DUCK_RAMP_MS=0
# BARGE_COMMIT_SPEECH_MS: sustained speech that commits the interruption. Default 900.
#BARGE_COMMIT_SPEECH_MS=900
# BARGE_RESUME_SILENCE_MS: quiet that resumes the reply. Default 400.
#BARGE_RESUME_SILENCE_MS=400
# BARGE_DECIDE_MAX_MS: decision ceiling (then resume). Default 2000.
#BARGE_DECIDE_MAX_MS=2000
# BARGE_PLAYOUT_LATENCY_MS: assumed sink latency when marking what was heard. Default 100.
#BARGE_PLAYOUT_LATENCY_MS=100
# BARGE_SEED_NEXT_TURN: a committed interruption becomes the next turn's audio (duck mode only). Default true.
#BARGE_SEED_NEXT_TURN=true

# ── Speaker identification ──────────────────────────────────────────────────────────────────────────────
# SPEAKER_ID_ENABLED: score each turn's speaker against the enrolled profiles. Default false.
SPEAKER_ID_ENABLED=true
# SPEAKER_ID_SHADOW: default-ON safety gate - log the claim but never attach it; only an explicit 0/false/no/off lifts it.
SPEAKER_ID_SHADOW=0
# SPEAKER_ID_SHADOW_LOG [site]: shadow metrics file (metadata only). Default ~/.zoe-voice/speaker_shadow_metrics.jsonl.
#SPEAKER_ID_SHADOW_LOG=~/.zoe-voice/speaker_shadow_metrics.jsonl
# SPEAKER_ID_SYNC_TTL_S: profile sync interval (s). Default 3600.
#SPEAKER_ID_SYNC_TTL_S=3600
# ZOE_SPEAKER_MODEL: resemblyzer | dual | resnet34 - must match zoe-data's value. Default resemblyzer.
ZOE_SPEAKER_MODEL=resnet34
# ZOE_SPEAKER_RESNET34_TIER: ResNet34 threshold tier (far1 = 1% FAR). Default far1.
#ZOE_SPEAKER_RESNET34_TIER=far1
# SPEAKER_RESNET34_MODEL_DIR [site]: where the pinned INT8 ResNet34 file lives. Default ~/.zoe-voice/models.
#SPEAKER_RESNET34_MODEL_DIR=~/.zoe-voice/models
# SPEAKER_ADAPT_SEND: offer high-certainty turns' embeddings to the server for profile adaptation. Default off.
#SPEAKER_ADAPT_SEND=
# SPEAKER_ADAPT_MIN_SCORE: Resemblyzer pre-filter score for an adaptation offer. Default 0.85.
#SPEAKER_ADAPT_MIN_SCORE=0.85
# SPEAKER_ADAPT_MIN_SPEECH_S: speech needed for an offer (s). Default 2.0.
#SPEAKER_ADAPT_MIN_SPEECH_S=2.0
# SPEAKER_ADAPT_MIN_GAP_S: minimum gap between offers (s). Default 60.
#SPEAKER_ADAPT_MIN_GAP_S=60
# SPEAKER_ADAPT_RESNET34_MIN_SCORE: ResNet34 pre-filter score for an offer. Default the module's 0.342.
#SPEAKER_ADAPT_RESNET34_MIN_SCORE=0.342

# ── Announcements and enrolment ─────────────────────────────────────────────────────────────────────────
# ZOE_ANNOUNCE_POLL_ENABLED: poll the server for announcements to speak. Default true.
#ZOE_ANNOUNCE_POLL_ENABLED=true
# ZOE_ANNOUNCE_POLL_S: announcement poll interval (s). Default 5.0.
#ZOE_ANNOUNCE_POLL_S=5.0
# ZOE_ENROLL_MODE_ENABLED: accept Zoe-driven voice enrolment commands. Default true.
#ZOE_ENROLL_MODE_ENABLED=true
# ZOE_ENROLL_RECORD_MAX_S: longest enrolment phrase recording (s). Default 8.0.
#ZOE_ENROLL_RECORD_MAX_S=8.0

# ── Face ID (zoe_face_id.py, zoe_enroll_flow.py) ────────────────────────────────────────────────────────
# FACE_ID_ENABLED: run face identification on the panel camera. Default false.
#FACE_ID_ENABLED=false
# FACE_CAMERA_INDEX [site]: camera index. Default 0.
#FACE_CAMERA_INDEX=0
# FACE_CAPTURE_FRAMES: frames per capture. Default 4.
#FACE_CAPTURE_FRAMES=4
# FACE_CAPTURE_SPAN_S: capture span (s). Default 0.8.
#FACE_CAPTURE_SPAN_S=0.8
# FACE_DET_THRESHOLD: face detector score threshold. Default 0.5.
#FACE_DET_THRESHOLD=0.5
# FACE_MIN_PX: smallest face box side in px (rejects far faces). Default 60.
FACE_MIN_PX=36
# FACE_MODEL_DIR [site]: face model directory. Default ~/.zoe-voice/models.
FACE_MODEL_DIR=/home/pi/.zoe-voice/models
# FACE_ID_SYNC_TTL_S: face profile sync interval (s). Default 3600.
#FACE_ID_SYNC_TTL_S=3600

# ── Ambient capture (off) ───────────────────────────────────────────────────────────────────────────────
# AMBIENT_CAPTURE_ENABLED: always-on VAD that transcribes room speech for ambient memory. Default false.
AMBIENT_CAPTURE_ENABLED=false
# AMBIENT_VAD_THRESHOLD: Silero probability for ambient speech. Default 0.4.
#AMBIENT_VAD_THRESHOLD=0.4
# AMBIENT_MIN_SPEECH_MS: shortest segment worth sending (ms). Default 500.
#AMBIENT_MIN_SPEECH_MS=500
# AMBIENT_SILENCE_PAD_MS: quiet that ends a segment (ms). Default 800.
#AMBIENT_SILENCE_PAD_MS=800

# ── Health endpoint and local control ───────────────────────────────────────────────────────────────────
# HEALTH_PORT: /health and the kiosk's POST /activate port. Default 7777.
#HEALTH_PORT=7777
# HEALTH_BIND [site]: bind address ("" = every interface on the Pi; the Jetson reads /health). Default per platform.
#HEALTH_BIND=
# ACTIVATE_GUARD: on = POST /activate and /enroll/cancel answer only the kiosk on this machine; off = rollback. Default on.
#ACTIVATE_GUARD=on
# ACTIVATE_ALLOWED_ORIGINS [site]: extra kiosk origins allowed to POST /activate (comma list). Default unset.
#ACTIVATE_ALLOWED_ORIGINS=

# ── Logging ─────────────────────────────────────────────────────────────────────────────────────────────
# ZOE_VOICE_LOG [site]: persistent daemon log file. Default unset (stderr only).
ZOE_VOICE_LOG=/home/pi/.zoe-voice/voice.log
