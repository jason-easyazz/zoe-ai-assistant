# Zoe Voice Daemon Environment Configuration
# Copy to /etc/zoe-voice.env and fill in your values:
#   sudo cp zoe-voice.env.example /etc/zoe-voice.env
#   sudo nano /etc/zoe-voice.env
#   sudo systemctl enable --now zoe-voice

# Required: Device token from Zoe panel auth
# Generate via: POST /api/panels/devices/register
DEVICE_TOKEN=your-device-token-here

# Zoe API base URL
ZOE_URL=https://zoe.local

# Panel identifier (shows up in panel list)
PANEL_ID=zoe-touch-main

# Microphone device name or index (run: python3 -c "import pyaudio; p=pyaudio.PyAudio(); [print(i, p.get_device_info_by_index(i)['name']) for i in range(p.get_device_count())]")
# Legacy alias still supported: MIC_DEVICE_INDEX
AUDIO_DEVICE=0

# SSL verification (set to 0 for self-signed certs on local network)
VERIFY_SSL=0

# Wake word sensitivity (0.0-1.0, lower = more sensitive but more false positives)
# Legacy alias still supported: OWW_THRESHOLD
WAKEWORD_THRESHOLD=0.5

# Recording controls
RECORD_SECONDS_MAX=12
SILENCE_TIMEOUT_S=1.5
RECORD_SILENCE_AMPLITUDE=300
# Long speech is ONE turn: RECORD_SECONDS_MAX is the SOFT cap; past it a recording stays open
# while the speaker is still talking, up to the hard caps below (conversation mode gets the
# higher one) and then runs on to the next pause (RECORD_SNAP_S). A recording that still ends
# mid-speech waits ZOE_CONTINUE_WINDOW_S for the rest and sends one merged clip; the same
# window is used when the server reports a transcript ending "...and". Old behaviour:
# RECORD_SECONDS_HARD_MAX=12 CONV_RECORD_SECONDS_HARD_MAX=12 RECORD_SNAP_S=0 ZOE_CONTINUE_WINDOW_S=0
RECORD_SECONDS_HARD_MAX=30
CONV_RECORD_SECONDS_HARD_MAX=60
RECORD_SNAP_S=3.0
ZOE_CONTINUE_WINDOW_S=2.0

# Persistent voice daemon log for recording stop reasons and STT results
ZOE_VOICE_LOG=/home/zoe/.zoe-voice/voice.log

# Speaker model (FLAG-DARK; docs/knowledge/speaker-resnet34-switch.md). Leave unset for today's behaviour.
#   resemblyzer (default) | dual (embed with BOTH, log both decisions on one shadow row, ACT on Resemblyzer) | resnet34 (ResNet34 acts).
# Needs the INT8 model on the Pi (scripts/setup/fetch_speaker_models.sh) and the SAME value in zoe-data's environment.
#ZOE_SPEAKER_MODEL=dual
# ResNet34 adaptation offer bar (the server re-checks everything); only matters with SPEAKER_ADAPT_SEND on AND resnet34 acting.
#SPEAKER_ADAPT_RESNET34_MIN_SCORE=0.342
